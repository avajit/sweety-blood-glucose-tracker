# Application environment
# Node environment (development | test | production)
NODE_ENV=development

# Port the Express server listens on
PORT=3000

# Pino log level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# IANA timezone name used for "today" computations
APP_TIMEZONE=Asia/Kolkata

# PostgreSQL connection string for the main database
DATABASE_URL=postgresql://postgres:password@localhost:5432/sweety

# PostgreSQL connection string for the test database
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/sweety_test

# PostgreSQL credentials (used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=sweety

# JWT secret — must be at least 32 characters
JWT_SECRET=change_me_to_a_random_secret_at_least_32_chars

# JWT expiry (e.g. 7d, 1h)
JWT_EXPIRES_IN=7d

# Set true only when the app is served over HTTPS; controls the cookie Secure flag
COOKIE_SECURE=false

# Exact browser origin (no trailing slash); used for CORS and CSRF origin check
CLIENT_ORIGIN=http://localhost:5173

# Set true only for demo/Docker seeding; seed refuses to run in production otherwise
ALLOW_DEMO_SEED=false

# Redis connection URL (optional); leave empty to disable cache and reminder job
REDIS_URL=

# Cron expression for the daily reminder job (default: 8 AM)
REMINDER_CRON=0 8 * * *

# API URL used by the Vite dev server proxy and client code
VITE_API_URL=http://localhost:3000

# Client-side timezone; must match APP_TIMEZONE
VITE_APP_TIMEZONE=Asia/Kolkata
