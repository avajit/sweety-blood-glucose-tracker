{
  "name": "@sweety/server",
  "version": "1.0.0",
  "type": "module",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/server.js",
    "dev:worker": "node --env-file-if-exists=../.env --watch src/worker.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "test": "vitest run",
    "lint": "eslint .",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../.env -- prisma db seed",
    "db:studio": "dotenv -e ../.env -- prisma studio"
  },
  "dependencies": {
    "@sweety/shared": "*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.17.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "web-push": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prisma/client": "^6.1.0",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.4"
  }
}
